msgstr ""

#:
#: /home/runner/work/MethodicConfigurator/MethodicConfigurator/ardupilot_methodic_configurator/configuration_steps_strings.py:47
msgid "Remote controller is mandatory in the initial configuration and tuning phases. Later might be required for operation and/or safety"
msgstr ""

