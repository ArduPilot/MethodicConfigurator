ATC_THR_MIX_MAN,0.5  # Because ALTHOLD flight mode was used for more than 30 seconds to correctly learn the MOT_THST_HOVER value
MOT_BAT_VOLT_MAX,16.799999  # To correctly scale the PID gains. Voltage of a healthy, fully charged battery immediately after takeoff. Read from a flight log
MOT_SPOOL_TIME,0.5  # left at default because copter is small
PSC_ACCZ_I,0.376478  # Use 2 * MOT_THST_HOVER assuming MOT_THST_HOVER has been correctly learned
PSC_ACCZ_P,0.188239  # Use MOT_THST_HOVER assuming MOT_THST_HOVER has been correctly learned
TKOFF_SLEW_TIME,2  # left at default because copter is small
