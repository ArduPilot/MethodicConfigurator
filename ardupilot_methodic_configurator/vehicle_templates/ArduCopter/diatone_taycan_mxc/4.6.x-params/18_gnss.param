BRD_SAFETY_DEFLT,0  # Matek H743 Slim has no safety switch
GPS_AUTO_CONFIG,0  # uBLOX F9P require this to be 0
GPS1_GNSS_MODE,39  # limit the constellations to ensure an update rate higher than 5Hz; 39 is a workaround for the error: EKF3 waiting for GPS config data
GPS1_POS_X,0.056  # HX-CH7604A GNSS antenna phase center location relative to CG
GPS1_POS_Y,0
GPS1_POS_Z,-0.07  # HX-CH7604A GNSS antenna phase center location relative to CG
GPS1_TYPE,2  # Defined in component editor
NTF_LED_TYPES,2369
SERIAL3_PROTOCOL,5  # GNSS receiver is connected to serial3
SERIAL4_PROTOCOL,-1
WPNAV_RADIUS,100  # we have a good GNSS receiver so we can afford to fly precisely
