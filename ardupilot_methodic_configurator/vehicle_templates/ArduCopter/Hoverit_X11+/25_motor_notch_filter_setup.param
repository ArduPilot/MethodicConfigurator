INS_FAST_SAMPLE,3  # Both IMUs can run fast on the CubeOrange flight controller
INS_GYRO_RATE,2  # The CubeOrange can do 4KHz here
INS_HNTCH_ATT,40  # based on a similar drone build
INS_HNTCH_BW,12  # based on a similar drone build
INS_HNTCH_ENABLE,1  # Use the first notch filter to filter the noise created by the motors/propellers
INS_HNTCH_FM_RAT,0.75  # Start filtering at 75% of the reference frequency (INS_HNTCH_FREQ)
INS_HNTCH_FREQ,28  # Use 1.4 * INS_GYRO_FILTER as a first guess
INS_HNTCH_HMNCS,1  # Most vehicles only require the main harmonic
INS_HNTCH_MODE,3  # Use ESC telemetry RPM to dynamically adjust the propeller notch filter
INS_HNTCH_OPTS,2  # Use one dynamic notch filter per motor to improve propeller-noise filter results
INS_HNTCH_REF,1  # ESC RPM telemetry
