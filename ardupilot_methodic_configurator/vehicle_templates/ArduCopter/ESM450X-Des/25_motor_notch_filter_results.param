INS_HNTCH_ATT,10  # just enough to filter the noise created by the motors/propellers
INS_HNTCH_BW,18  # just enough to filter the noise created by the motors/propellers
INS_HNTCH_FM_RAT,0.65  # Allowed undercutting of the base frequency of the first notch filter
INS_HNTCH_FREQ,64  # the minimum frequency that the motors are expected to operate at
INS_HNTCH_HMNCS,3  # the motors produce secondary harmonics on this vehicle
INS_HNTCH_OPTS,6  # two notches (1st and 2nd Harmonic) per motor
INS_HNTCH_REF,1  # Should be set to 1 to enable seeing Motor RPM through ESC Telem
