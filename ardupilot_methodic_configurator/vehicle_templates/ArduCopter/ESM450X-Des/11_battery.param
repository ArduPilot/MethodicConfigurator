BATT_ARM_VOLT,10.5  # Only arm above this voltage, to avoid taking off with insufficient battery capacity
BATT_CAPACITY,5000  # Total battery capacity specified in the component editor
BATT_CRT_MAH,0  # No capacity based failsafes, unreliable
BATT_CRT_VOLT,9.9  # Critical failsafe voltage x nr. of cells
BATT_FS_CRT_ACT,1  # Land ASAP
BATT_FS_LOW_ACT,2  # Return and land at home or rally point
BATT_LOW_MAH,0  # No capacity based failsafes, unreliable
BATT_LOW_TIMER,5
BATT_LOW_VOLT,10.5  # Low failsafe voltage x nr. of cells
MOT_BAT_VOLT_MAX,12.6  # Scale the PIDs up when battery voltage is below this threshold
MOT_BAT_VOLT_MIN,9.9  # Scale the PIDs up when battery voltage is above this threshold
