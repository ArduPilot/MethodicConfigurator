Q_TILT_ENABLE,1  # Enable tilt-rotor support. AMC reboots the FC first, which also activates Q_FRAME_CLASS=7 from step 08
Q_TILT_MASK,3  # Motor 1 (front right) and motor 2 (front left) tilt. Rear motor 4 is fixed in the lift position
Q_TILT_RATE_DN,15  # Slow tilt rate for the first transitions, as the tilt-rotor guide suggests. Increase gradually
Q_TILT_RATE_UP,15  # Slow tilt rate for the first transitions, as the tilt-rotor guide suggests. Increase gradually
Q_TILT_TYPE,2  # Vectored yaw: the left and right tilt servos move differentially for yaw in hover
Q_TILT_YAW_ANGLE,10  # Starting value. Measure how many degrees the motors tilt back past vertical at the hover endpoint of the tilt servo
SERVO10_FUNCTION,19  # Elevator, PWM, timer group 7-10
SERVO10_MAX,1900
SERVO10_MIN,1100
SERVO10_REVERSED,0
SERVO10_TRIM,1500
