NTF_BUZZ_TYPES,5
NTF_LED_TYPES,647367
Q_M_PWM_MAX,2000  # DShot: the ESC throttle range is fixed
Q_M_PWM_MIN,1000  # DShot: the ESC throttle range is fixed
Q_M_SPIN_ARM,0.1  # Find the lowest reliable value with the motor test in step 12
Q_M_SPIN_MAX,0.95
Q_M_SPIN_MIN,0.15  # Must be above Q_M_SPIN_ARM. Check with the motor test in step 12
SERVO_BLH_AUTO,1  # Auto-enable BLHeli passthrough on the VTOL motors. The tri motor mask covers only motors 1, 2 and 4, so the Motor 7 output on SERVO11 is not included
SERVO_BLH_BDMASK,7  # Bidirectional DShot (RPM telemetry) on the ESC outputs 1, 2 and 3. Requires a -bdshot firmware target and BDShot-capable ESCs (AM32, Bluejay or BLHeli32)
SERVO_BLH_MASK,7  # BLHeli passthrough and DShot commands on the ESC outputs 1, 2 and 3
SERVO_DSHOT_ESC,0
SERVO_DSHOT_RATE,0
